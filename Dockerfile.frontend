FROM node:22-alpine AS base

# Git is required by the postinstall script (lefthook install)
RUN apk add --no-cache git

# Dependencies
FROM base AS deps
WORKDIR /usr/app
COPY package*.json ./
# Skip scripts: postinstall runs "lefthook install", which needs a .git repo
RUN npm ci --ignore-scripts

# Development stage
FROM base AS development
WORKDIR /usr/app
COPY --from=deps /usr/app/node_modules ./node_modules
COPY . .
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["npm", "run", "dev"]

# Production runner
FROM base AS production
WORKDIR /usr/app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    chown -R nextjs:nodejs /usr/app

COPY --from=deps --chown=nextjs:nodejs /usr/app/node_modules ./node_modules
COPY --chown=nextjs:nodejs . .

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["sh", "-c", "npm run build && npm start"]