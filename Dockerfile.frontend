FROM node:22-alpine AS base

# Git is required by the postinstall script (lefthook install)
RUN apk add --no-cache git

# Dependencies
FROM base AS deps
WORKDIR /usr/app
COPY package*.json ./
# Skip scripts: postinstall runs "lefthook install", which needs a .git repo
RUN npm ci --ignore-scripts

# Builder: production build with standalone output.
# Generated GraphQL types are committed to the repo, so codegen is skipped
# and WordPress does not need to be reachable at image build time
# (data-fetch failures during prerender are handled gracefully).
FROM base AS builder
WORKDIR /usr/app
COPY --from=deps /usr/app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx next build

# Development stage
FROM base AS development
WORKDIR /usr/app
COPY --from=deps /usr/app/node_modules ./node_modules
COPY . .
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["npm", "run", "dev"]

# Production runner: minimal Next.js standalone server (output: "standalone")
FROM node:22-alpine AS production
WORKDIR /usr/app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /usr/app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /usr/app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /usr/app/public ./public

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
